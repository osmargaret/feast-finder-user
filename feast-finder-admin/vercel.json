{
  "build": {
    "outDir": "dist",
    "emptyOutDir": true,
    "installCommand": "npm install",
    "buildCommand": "npm run build"
  },
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "functions": {
    "src/main.tsx": {
      "maxDuration": 10
    }
  },
  "regions": ["iad1"],
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "crons": []
}
