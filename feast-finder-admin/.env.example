# Feast Finder Admin — Environment Configuration
# Copy this file to .env and fill in your values

# Authentication (replace with real auth provider)
VITE_AUTH_SECRET=your-secret-key-here
VITE_ADMIN_EMAIL=admin@feastfinder.com

# API Endpoints (replace with actual backend URLs)
VITE_API_URL=http://localhost:3000/api
VITE_APP_URL=http://localhost:5173

# Optional: External Services
# VITE_SENTRY_DSN=your-sentry-dsn
# VITE_GOOGLE_MAPS_API_KEY=your-maps-key

# Environment
NODE_ENV=development
